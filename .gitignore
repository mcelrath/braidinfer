target/
.envrc

# Dolt database files (added by bd init)
.dolt/
*.db
models/

# Python
__pycache__

# Models
*.bqnt

# hipcc compiler intermediates (left behind from manual / interrupted builds)
*-hip-amdgcn-amd-amdhsa-gfx1100.bc
*-hip-amdgcn-amd-amdhsa-gfx1100.bc.tmp
*-hip-amdgcn-amd-amdhsa-gfx1100.hipi
*-hip-amdgcn-amd-amdhsa-gfx1100.o
*-hip-amdgcn-amd-amdhsa-gfx1100.out
*-hip-amdgcn-amd-amdhsa-gfx1100.out.resolution.txt
*-hip-amdgcn-amd-amdhsa-gfx1100.s
*-host-x86_64-pc-linux-gnu.bc
*-host-x86_64-pc-linux-gnu.hipi
*-host-x86_64-pc-linux-gnu.s
*-host-x86_64-pc-linux-gnu.o
*.hip-hip-amdgcn-amd-amdhsa.hipfb

# Diagnostic reproducer binaries (built via kernels/diagnostic/build_repro.sh)
kernels/diagnostic/bpermute_repro

# Activation traces (regenerated via TRACE=... target/release/generate)
*.bin

# Profiling / benchmark outputs (ad-hoc; not committed)
profile_results/
benchmark_results/*
.rocprofv3/
# Carve-out: regression artifacts captured to prove a fix or document
# a reproducible behavior live in benchmark_results/regression/ and
# ARE committed. Anything else under benchmark_results/ stays ignored.
!benchmark_results/regression/

# Bob's workflow
.claude
.worktrees
kernels/diagnostic/persistent_skeleton_repro/host_runner
